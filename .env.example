# PokéValue AU — Environment Variables
# Copy this file to .env and fill in your credentials
# NEVER commit .env to GitHub

EBAY_APP_ID=your_app_id_here
EBAY_CERT_ID=your_new_cert_id_here
EBAY_DEV_ID=your_dev_id_here

# eBay notification endpoint validation
EBAY_VERIFICATION_TOKEN=pokevalue-au-ebay-verify-token-2026
EBAY_ENDPOINT_URL=https://pokevalue-au-backend.onrender.com/ebay/account-deletion

PORT=3000
